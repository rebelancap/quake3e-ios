 /*
+=================
+CL_VRTurn
+
+Snap and smooth turn, as an additive yaw. The shell owns the feel (mode, degrees
+per second, the snap hysteresis) and hands over finished degrees; this is only
+the seam that gets them into the authoritative accumulator.
+
+Additive is what makes it survive teleports and respawns: pmove works from the
+usercmd angles plus the playerstate's delta_angles, so a yaw the client adds
+rides through a delta-angle reset instead of being erased by it.
+=================
+*/
+static void CL_VRTurn( void )
+{
+	if ( cl_vr_turn_pending == 0.0f )
+		return;
+	cl.viewangles[YAW] += cl_vr_turn_pending;
+	cl_vr_turn_pending = 0.0f;
+}
+
+/*
+=================
+CL_VRHeightClamp
+
+A tall player standing under a low ceiling puts the camera inside the geometry,
+and the inside of a Quake 3 brush is a solid colour with the world missing —
+alarming in full immersion. So the requested rise is traced against the map and
+cut to what fits.
+
+Asymmetric on purpose: ducking under a ceiling is INSTANT (the alternative is
+being inside it for the duration of an ease), and coming back up is eased, so
+walking out from under a doorway lifts the player rather than launching them.
+=================
+*/
+static void CL_VRHeightClamp( void )
+{
+	static float applied = 0.0f;
+	static int   lastTime = 0;
+	const float  margin = 6.0f;      // stay this far below the surface found
+	const float  riseRate = 40.0f;   // units per second on the way back up
+	float allowed, dt;
+	int now;
+
+	// The request is the gate: only the VR shell ever writes it, and it writes
+	// zero the moment VR is not the mode.
+	if ( cl_vr_height_request <= 0.0f ) {
+		applied = ( cl_vr_height_request < 0.0f ) ? cl_vr_height_request : 0.0f;
+		cl_vr_height_rise = applied;
+		lastTime = 0;
+		return;
+	}
+
+	allowed = cl_vr_height_request;
+
+	// Only trace with a live snapshot and a collision model: cls.state gates both,
+	// and cgame is what loaded the map on this side.
+	if ( cls.state == CA_ACTIVE && cl.snap.valid ) {
+		trace_t tr;
+		vec3_t start, end;
+
+		VectorCopy( cl.snap.ps.origin, start );
+		start[2] += cl.snap.ps.viewheight;
+		VectorCopy( start, end );
+		end[2] += allowed + margin;
+
+		CM_BoxTrace( &tr, start, end, vec3_origin, vec3_origin, 0, CONTENTS_SOLID, qfalse );
+		if ( tr.fraction < 1.0f ) {
+			allowed = ( allowed + margin ) * tr.fraction - margin;
+			if ( allowed < 0.0f )
+				allowed = 0.0f;
+		}
+	}
+
+	now = Sys_Milliseconds();
+	dt = ( lastTime && now > lastTime ) ? ( now - lastTime ) * 0.001f : 0.0f;
+	lastTime = now;
+	if ( dt > 0.25f )
+		dt = 0.25f;      // a level load is not a second of rising
+
+	if ( allowed <= applied ) {
+		applied = allowed;               // duck instantly
+	} else {
+		applied += riseRate * dt;        // rise eased
+		if ( applied > allowed )
+			applied = allowed;
+	}
+	cl_vr_height_rise = applied;
+}
+#endif // USE_VULKAN_API
