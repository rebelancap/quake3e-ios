+// WITH the 2D on it, which is the whole thing this mechanism exists to prevent.
+int vk_vr_ui_field_split( int field )
+{
+	if ( field == 1 ) return q3s_ui_split[0];
+	if ( field == 2 ) return q3s_ui_split[1];
+	return 0;
+}
