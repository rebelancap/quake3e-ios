+// The brightness treatment the engine's OWN gamma pass applies on its way to the
+// swapchain: pow(colour, 1/r_gamma) * (1 << overbrightBits).
+//
+// That pass runs in the FBO->swapchain blit, which never executes while the
+// engine renders off-screen for a compositor — so anything sampling the FBO
+// directly (the 3D panel, the VR eye blit) has to apply the same treatment or
+// show the player a picture that is both un-brightened AND darker than the flat
+// window by the whole overbright factor, which is a factor of two by default.
+// Reported rather than assumed, and read live, so a brightness change in the
+// menu reaches the compositor without a restart.
+void VK_GetGammaOverbright( float *invGamma, float *obScale )
+{
+	if ( invGamma )
+		*invGamma = ( r_gamma && r_gamma->value > 0.0f ) ? 1.0f / r_gamma->value : 1.0f;
+	if ( obScale )
+		*obScale = ( tr.overbrightBits > 0 ) ? (float)( 1 << tr.overbrightBits ) : 1.0f;
+}
+
+// Where the FINISHED per-eye projection puts the four frustum edges that were
+// asked for. See get_mvp_transform: a correct Vulkan-convention projection puts
+// them at NDC -1 / +1 / +1 / -1 (left, right, bottom, top), and any other answer
+// means the matrix the GPU uses is not the frustum the compositor was told about.
+void VK_GetVREdgeNDC( int eye, float *out4 )
+{
+	int i;
+	if ( eye < 0 || eye > 1 || !out4 )
+		return;
+	for ( i = 0; i < 4; i++ )
+		out4[i] = vk_vr_edge_ndc[eye][i];
