+/*
+=================
+R_VRRebaseViewmodel
+
+The first-person weapon, moved from the face to the hand — WITHOUT touching the
+cgame, which is a QVM this project never forks.
+
+CG_AddViewWeapon builds the hand, the weapon, the barrel and the muzzle flash as
+ordinary refdef entities carrying RF_FIRST_PERSON, placed relative to the game's
+own view. So their pose relative to that view is exactly the thing to preserve:
+
+    new = handFrame * inverse(viewFrame) * entFrame
+
+Every bob, sway, lag and cg_gun_x/y/z offset the cgame baked in rides along
+unchanged; only what the whole assembly is attached to changes. Nothing here
+needs to know which entity is the gun and which is the flash, which is why a mod
+with a different weapon model works for free.
+
+RUN ONCE PER SCENE, and only ever on a fresh entity array: the transform reads
+each entity's CURRENT pose, so applying it twice would compound. That holds by
+construction — the cgame clears and refills the scene for every field, and this
+runs after the refill and before the render.
+
+DEPTHHACK is not disabled here; the backend already declines it for a VR view
+(patch 0009), which is the right place for it: the gun is a real object at a real
+distance and its true depth is what the compositor must reproject against.
+=================
+*/
+static void R_VRRebaseViewmodel( const refdef_t *fd )
+{
+	vec3_t hand[3], org, f, r, u, nf, nr, nu;
+	float relOrigin[3], relAxis[3][3];
+	const float d2r = (float)(M_PI / 180.0);
+	float sp, cp, sy, cy, sr, cr;
+	int i, j, n;
+
+	vk_vr_gun_entities = 0;
+	vk_vr_gun_mounted = 0;
+
+	if ( !vk_vr_active || ( fd->rdflags & RDF_NOWORLDMODEL ) )
+		return;
+	if ( !R_VRComposeHand( fd->vieworg, fd->viewaxis, vk_vr_aim_hand, org, hand ) )
+		return;		// that hand is not tracked: the cgame's own placement stands
+
+	VectorCopy( org, vk_vr_hand_world );
+
+	// The grip correction. It moves the MODEL only — the aim ray is the raw hand
+	// direction and is computed on the other side of the rendezvous — because a
+	// tuning slider that also moved where the shot goes would be an aiming bug
+	// wearing a cosmetic label.
+	VectorCopy( hand[0], f );
+	VectorCopy( hand[1], r );	// Q3's second axis is LEFT, not right
+	VectorCopy( hand[2], u );
+	sp = sin( vk_vr_grip_angles[0] * d2r ); cp = cos( vk_vr_grip_angles[0] * d2r );
+	sy = sin( vk_vr_grip_angles[1] * d2r ); cy = cos( vk_vr_grip_angles[1] * d2r );
+	sr = sin( vk_vr_grip_angles[2] * d2r ); cr = cos( vk_vr_grip_angles[2] * d2r );
+	// pitch about LEFT: +pitch tips the nose DOWN, matching Quake's own sign
+	for ( i = 0; i < 3; i++ ) { nf[i] = f[i] * cp - u[i] * sp; nu[i] = f[i] * sp + u[i] * cp; }
+	VectorCopy( nf, f ); VectorCopy( nu, u );
+	// yaw about UP: +yaw swings LEFT, matching Quake's own sign
+	for ( i = 0; i < 3; i++ ) { nf[i] = f[i] * cy + r[i] * sy; nr[i] = r[i] * cy - f[i] * sy; }
+	VectorCopy( nf, f ); VectorCopy( nr, r );
+	// roll about FORWARD
+	for ( i = 0; i < 3; i++ ) { nr[i] = r[i] * cr + u[i] * sr; nu[i] = u[i] * cr - r[i] * sr; }
+	VectorCopy( nr, r ); VectorCopy( nu, u );
+
+	// The offsets are stated as forward/RIGHT/up because that is how a person
+	// describes where a gun sits in a fist; the second axis here is LEFT, so the
+	// right component is subtracted.
+	VectorMA( org,  vk_vr_grip[0], f, org );
+	VectorMA( org, -vk_vr_grip[1], r, org );
+	VectorMA( org,  vk_vr_grip[2], u, org );
+
+	VectorCopy( f, hand[0] );
+	VectorCopy( r, hand[1] );
+	VectorCopy( u, hand[2] );
+
+	n = r_numentities - r_firstSceneEntity;
+	for ( i = 0; i < n; i++ ) {
+		trRefEntity_t *ent = &backEndData->entities[ r_firstSceneEntity + i ];
+		vec3_t d;
+
+		if ( !( ent->e.renderfx & RF_FIRST_PERSON ) )
+			continue;
+
+		// Where this entity sits relative to the game view, in the view's own
+		// axes. Orthonormal, so the inverse is the dot products.
+		VectorSubtract( ent->e.origin, fd->vieworg, d );
+		for ( j = 0; j < 3; j++ )
+			relOrigin[j] = DotProduct( d, fd->viewaxis[j] ) * vk_vr_gun_scale;
+		for ( j = 0; j < 3; j++ ) {
+			relAxis[j][0] = DotProduct( ent->e.axis[j], fd->viewaxis[0] );
+			relAxis[j][1] = DotProduct( ent->e.axis[j], fd->viewaxis[1] );
+			relAxis[j][2] = DotProduct( ent->e.axis[j], fd->viewaxis[2] );
+		}
+
+		// ...re-attached to the hand.
+		VectorCopy( org, ent->e.origin );
+		for ( j = 0; j < 3; j++ )
+			VectorMA( ent->e.origin, relOrigin[j], hand[j], ent->e.origin );
+		for ( j = 0; j < 3; j++ ) {
+			VectorScale( hand[0], relAxis[j][0], ent->e.axis[j] );
+			VectorMA( ent->e.axis[j], relAxis[j][1], hand[1], ent->e.axis[j] );
+			VectorMA( ent->e.axis[j], relAxis[j][2], hand[2], ent->e.axis[j] );
+			if ( vk_vr_gun_scale != 1.0f )
+				VectorScale( ent->e.axis[j], vk_vr_gun_scale, ent->e.axis[j] );
+		}
+		if ( vk_vr_gun_scale != 1.0f )
+			ent->e.nonNormalizedAxes = qtrue;
+
+		// RF_LIGHTING_ORIGIN entities light from a point the cgame chose next to
+		// the OLD position; left alone, a weapon carried into a dark corner would
+		// keep the lighting of wherever the player's face is. Moved through the
+		// same transform, so it stays in the same place relative to the model.
+		if ( ent->e.renderfx & RF_LIGHTING_ORIGIN ) {
+			vec3_t lo;
+			VectorSubtract( ent->e.lightingOrigin, fd->vieworg, d );
+			for ( j = 0; j < 3; j++ )
+				relOrigin[j] = DotProduct( d, fd->viewaxis[j] ) * vk_vr_gun_scale;
+			VectorCopy( org, lo );
+			for ( j = 0; j < 3; j++ )
+				VectorMA( lo, relOrigin[j], hand[j], lo );
+			VectorCopy( lo, ent->e.lightingOrigin );
+		}
+
+		if ( vk_vr_gun_entities == 0 ) {
+			VectorCopy( ent->e.origin, vk_vr_gun_origin );
+			// Diagnostics only. vectoangles gives pitch and yaw from the forward
+			// axis and leaves roll at zero; roll comes from the other two. The
+			// engine has no axis-to-angles helper of its own, and adding one for
+			// a dump would be a wider change than the dump is worth.
+			vectoangles( ent->e.axis[0], vk_vr_gun_angles );
+			vk_vr_gun_angles[ROLL] =
+				atan2( ent->e.axis[1][2], ent->e.axis[2][2] ) * 180.0f / M_PI;
+		}
+		vk_vr_gun_entities++;
+	}
+	vk_vr_gun_mounted = ( vk_vr_gun_entities > 0 );
+}
 #endif
 
 
