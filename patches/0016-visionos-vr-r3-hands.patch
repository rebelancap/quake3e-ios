+// Overlay patch 0016. Same contract as VK_SetVREye and the same caller: one
+// snapshot, one thread, once per engine frame. `valid` 0 means the hand is not
+// tracked this frame — the viewmodel then stays exactly where the cgame put it,
+// which is the R2 behaviour and the correct fallback.
+void VK_SetVRHand( int hand, int valid, const float offset[3], const float axis[9] )
+{
+	int i;
+	if ( hand < 0 || hand > 1 )
+		return;
+	vk_vr_hand_valid[hand] = valid ? 1 : 0;
+	if ( !valid )
+		return;
+	for ( i = 0; i < 3; i++ )
+		vk_vr_hand_offset[hand][i] = offset[i];
+	for ( i = 0; i < 9; i++ )
+		vk_vr_hand_axis[hand][i / 3][i % 3] = axis[i];
+}
+
+void VK_SetVRGun( int aimHand, float scale, const float grip[3], const float gripAngles[3] )
+{
+	int i;
+	vk_vr_aim_hand = aimHand ? 1 : 0;
+	// A scale of zero collapses the model to a point and a negative one turns it
+	// inside out; both are values a slider or a console typo can produce and
+	// neither is recoverable by looking at the result.
+	if ( scale >= 0.1f && scale <= 8.0f )
+		vk_vr_gun_scale = scale;
+	if ( grip ) {
+		for ( i = 0; i < 3; i++ )
+			vk_vr_grip[i] = grip[i];
+	}
+	if ( gripAngles ) {
+		for ( i = 0; i < 3; i++ )
+			vk_vr_grip_angles[i] = gripAngles[i];
+	}
+}
+
+void VK_VRGunString( char *buf, int size )
+{
+	if ( !buf || size <= 0 )
+		return;
+	Com_sprintf( buf, size,
+		"aimhand=%s handvalid=(L%d,R%d) mounted=%d entities=%d "
+		"hand=(%.1f,%.1f,%.1f)u gun=(%.1f,%.1f,%.1f)u gunang=(p%.1f,y%.1f,r%.1f)deg "
+		"depthhack=off",
+		vk_vr_aim_hand ? "right" : "left",
+		vk_vr_hand_valid[0], vk_vr_hand_valid[1],
+		vk_vr_gun_mounted, vk_vr_gun_entities,
+		vk_vr_hand_world[0], vk_vr_hand_world[1], vk_vr_hand_world[2],
+		vk_vr_gun_origin[0], vk_vr_gun_origin[1], vk_vr_gun_origin[2],
+		vk_vr_gun_angles[0], vk_vr_gun_angles[1], vk_vr_gun_angles[2] );
+}
