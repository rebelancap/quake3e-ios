+/*
+=================
+R_VRComposeHand
+
+The same thing for a hand, and DELIBERATELY the same arithmetic: one body basis,
+one height rise, one place to be wrong. A second derivation for the weapon is
+how a port ends up with a gun that drifts against the world it is held in.
+
+Returns false when that hand is not tracked this frame, which is the caller's
+signal to leave the viewmodel exactly where the cgame put it.
+=================
+*/
+qboolean R_VRComposeHand( const float vieworg[3], const float viewaxis[3][3], int hand,
+						  float outOrigin[3], float outAxis[3][3] )
+{
+	vec3_t body[3];
+	float yaw, s, c;
+	int i;
+
+	if ( hand < 0 || hand > 1 || !vk_vr_hand_valid[hand] )
+		return qfalse;
+
+	yaw = atan2( viewaxis[0][1], viewaxis[0][0] );
+	s = sin( yaw );
+	c = cos( yaw );
+
+	VectorSet( body[0],  c,  s, 0.0f );		// forward
+	VectorSet( body[1], -s,  c, 0.0f );		// left
+	VectorSet( body[2], 0.0f, 0.0f, 1.0f );	// up
+
+	VectorCopy( vieworg, outOrigin );
+	for ( i = 0; i < 3; i++ ) {
+		VectorMA( outOrigin, vk_vr_hand_offset[hand][i], body[i], outOrigin );
+	}
+
+	if ( cl_vr_height_rise != 0.0f )
+		VectorMA( outOrigin, cl_vr_height_rise, body[2], outOrigin );
+
+	for ( i = 0; i < 3; i++ ) {
+		VectorScale( body[0], vk_vr_hand_axis[hand][i][0], outAxis[i] );
+		VectorMA( outAxis[i], vk_vr_hand_axis[hand][i][1], body[1], outAxis[i] );
+		VectorMA( outAxis[i], vk_vr_hand_axis[hand][i][2], body[2], outAxis[i] );
+	}
+	return qtrue;
+}
 #endif
 
 
