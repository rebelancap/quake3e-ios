+// --- overlay patch 0022: the Damage Flash row (R4.3 item 3) ----------------
+// Quake III's damage blend is drawn by the cgame QVM, not by the engine: there
+// is no cvar behind it and no engine code that knows it happened. What the
+// engine CAN see is the 2D pic itself — id's cgame draws it with a shader it
+// registers under one fixed name, and every mod that descends from that source
+// (CPMA and OSP among them) keeps the name. So the gate lives at the one place
+// every 2D pic passes through, keyed on the shader's own name.
+extern int   vk_vr_damage_flash;	// 0 = drop the cgame's blood-blend pic
+extern int   vk_vr_damage_seen;		// blood-blend pics offered, this session
+extern int   vk_vr_damage_dropped;	// ...and how many the gate actually dropped
+int  VK_VRIsDamageBlend( qhandle_t hShader );
