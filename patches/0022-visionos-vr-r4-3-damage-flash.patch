+// --- overlay patch 0022 (R4.3 item 3) ---------------------------------------
+// An ENGINE-side global for the same reason vk_vr_xhair_scale is one: the shell
+// that owns the settings row is linked only into the visionOS app, and these
+// sources are compiled for the oracle and the iPhone build as well.
+int vk_vr_damage_flash = 1;
+int vk_vr_damage_seen = 0;
+int vk_vr_damage_dropped = 0;
+void VK_SetVRDamageFlash( int on ) {
+	vk_vr_damage_flash = on ? 1 : 0;
+}
+// Is this handle the cgame's damage blend?
+//
+// Keyed on the shader's NAME, which is the only thing about it this engine can
+// know: the blend belongs to the cgame QVM, it is registered at map load like
+// any other piece of media, and "viewBloodBlend" is the name id's own cgame
+// registers it under — inherited, unchanged, by the mods that descend from that
+// source (verified against CPMA 1.53's own cgame.qvm).
+//
+// Deliberately NOT a handle cached at registration time: handles are reissued
+// on every vid_restart and every fs_game change, and a cached one gone stale
+// stops gating — or gates something else — with nothing to show for it.
+int VK_VRIsDamageBlend( qhandle_t hShader ) {
+	const shader_t *sh;
+	if ( hShader <= 0 )
+		return 0;
+	sh = R_GetShaderByHandle( hShader );
+	if ( sh == NULL || sh->name[0] != 'v' )
+		return 0;
+	return !Q_stricmp( sh->name, "viewBloodBlend" );
+}
+// Returns the number of blood-blend pics SEEN and writes the number DROPPED.
+// Both, because "off and nothing dropped" and "off and never offered" are
+// different states and only the pair tells them apart.
+int VK_GetVRDamageBlends( int *dropped ) {
+	if ( dropped )
+		*dropped = vk_vr_damage_dropped;
+	return vk_vr_damage_seen;
+}
+
 int vk_vr_ui_redirect = 0;                   // shell: this frame is a VR WORLD frame
 int vk_vr_ui_frames = 0;                     // UI layer snapshots taken (freshness)
