+/*
+=================
+VK_VRSkyForceDepthClear
+
+overlay patch 0017 (DIAGNOSTIC) — clear depth whatever the dirty flag says.
+vk_clear_depth's early-out is a correctness optimisation (nothing has written
+depth since the pass began, so there is nothing to clear); this diagnostic is
+asking the opposite question — whether the buffer the sky is tested against
+really is clear — so it must not take that flag's word for it.
+=================
+*/
+void VK_VRSkyForceDepthClear( void )
+{
+	const int wasDirty = vk_world.dirty_depth_attachment;
+
+	if ( !vk.active || vk.cmd == NULL )
+		return;
+
+	vk_world.dirty_depth_attachment = 1;
+	vk_clear_depth( qfalse );
+	vk_world.dirty_depth_attachment = wasDirty;
+}
