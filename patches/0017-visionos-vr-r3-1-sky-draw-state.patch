+	out->scissorSet[2] = (int)vk.cmd->scissor_rect.extent.width;
+	out->scissorSet[3] = (int)vk.cmd->scissor_rect.extent.height;
+
+	get_scissor_rect( &want );
+	out->scissorWant[0] = (int)want.offset.x;
+	out->scissorWant[1] = (int)want.offset.y;
+	out->scissorWant[2] = (int)want.extent.width;
+	out->scissorWant[3] = (int)want.extent.height;
