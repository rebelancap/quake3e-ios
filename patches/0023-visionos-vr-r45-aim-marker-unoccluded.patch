+
+// --- overlay patch 0023 (R4.5) ----------------------------------------------
+// The two marker diagnostics. Inert here, so a public build that never
+// registers the commands behaves exactly as if this code were absent: zero
+// push is the shipped placement, and depthtest 0 is the shipped shader.
+float vk_vr_xhair_push = 0.0f;
+int   vk_vr_xhair_depthtest = 0;
+void VK_SetVRXhairProbe( float push, int depthTest ) {
+	// Clamped rather than rejected: this is a probe a human types at a console,
+	// and a silently ignored value reads as "the probe does nothing", which is
+	// the same sentence as the bug it is here to reproduce.
+	if ( push < -512.0f ) push = -512.0f;
+	if ( push >  512.0f ) push =  512.0f;
+	vk_vr_xhair_push = push;
+	vk_vr_xhair_depthtest = depthTest ? 1 : 0;
 }
+void VK_GetVRXhairProbe( float *push, int *depthTest ) {
+	if ( push ) *push = vk_vr_xhair_push;
+	if ( depthTest ) *depthTest = vk_vr_xhair_depthtest;
+}
 
