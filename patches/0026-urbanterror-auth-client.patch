+// Urban Terror's ui.qvm passes a pointer to its OWN netadr_t for the engine to
+// fill in (UI_NET_STRINGTOADR below). That struct is Quake III's original
+// IPv4-only one and this engine's is IPv6-capable and more than twice its size,
+// so nothing may be written through that pointer in the engine's own layout —
+// it would run sixteen bytes past the end of the mod's buffer and corrupt the
+// VM heap. Everything crossing the boundary is repacked into these 12 bytes.
+// The two enums also disagree: id's original starts NA_BOT, NA_BAD and this
+// engine starts NA_BAD, NA_BOT, so the type is mapped rather than cast.
+#define VM_NA_BOT		0
+#define VM_NA_BAD		1
+#define VM_NA_LOOPBACK	2
+#define VM_NA_BROADCAST	3
+#define VM_NA_IP		4
+
+typedef struct {
+	int32_t		type;
+	byte		ip[4];
+	uint16_t	port;
+	uint16_t	pad;
+} vmNetadr_t;
+
+typedef char vmNetadr_is_the_legacy_size[ (sizeof(vmNetadr_t) == 12) ? 1 : -1 ];
+
+static int CL_UI_PackNetadr( vmNetadr_t *out, const netadr_t *in ) {
+	Com_Memset( out, 0, sizeof( *out ) );
+	switch ( in->type ) {
+		case NA_BOT:		out->type = VM_NA_BOT; break;
+		case NA_LOOPBACK:	out->type = VM_NA_LOOPBACK; break;
+		case NA_BROADCAST:	out->type = VM_NA_BROADCAST; break;
+		case NA_IP:			out->type = VM_NA_IP; break;
+		// IPv6 has no representation in a QVM built in 1999. Telling the mod
+		// the lookup failed is the honest answer; it will not try to send.
+		default:			out->type = VM_NA_BAD; return 0;
+	}
+	Com_Memcpy( out->ip, in->ipv._4, 4 );
+	out->port = in->port;
+	return 1;
+}
