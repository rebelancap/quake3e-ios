+// Called at the start of each field (vk_vr_ui_field), so the numbers a dump
+// reads describe one complete eye rather than whatever was in flight.
+void VK_VRSkyBeginField( int eye )
+{
+	if ( eye < 0 || eye > 1 )
+		eye = 0;
+	vk_sky_diag_pub[eye] = vk_sky_diag[eye];
+	VK_VRSkyReset( eye );
