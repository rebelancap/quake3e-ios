+static vkSkyDiag_t	vk_sky_diag[2];		// live, per eye
+static vkSkyDiag_t	vk_sky_diag_pub[2];	// last complete field, what the dump reads
+
+static void VK_VRSkyReset( int eye )
+{
+	int i;
+	Com_Memset( &vk_sky_diag[eye], 0, sizeof( vk_sky_diag[eye] ) );
+	vk_sky_diag[eye].eye = eye;
+	for ( i = 0; i < 6; i++ ) {
+		vk_sky_diag[eye].mins[i][0] = vk_sky_diag[eye].mins[i][1] =  9999.0f;
+		vk_sky_diag[eye].maxs[i][0] = vk_sky_diag[eye].maxs[i][1] = -9999.0f;
+	}
