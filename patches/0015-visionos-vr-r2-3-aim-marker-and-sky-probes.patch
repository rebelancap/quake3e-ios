+#ifdef USE_VULKAN
+/*
+=================
+R_VRAddAimMarker
+
+The VR crosshair: a plus drawn IN THE WORLD, at the point the aim ray reaches,
+at a constant ANGULAR size so it neither swells at a wall nor vanishes down a
+corridor. Every linear dimension is radians times the distance from THIS eye,
+so both eyes see the same world point at their own correct size and the stereo
+depth is a consequence of the geometry rather than a value someone chose.
+
+Four arms, each its own quad, each a successive 90-degree rotation of the same
+(right, up) basis so all four have the same handedness — a sign flip or an axis
+swap per arm is a mirror, and a mirrored quad is a reversed winding. The shader
+is two-sided as well; the belt and the braces together cost four triangles and
+close a class of defect that has cost a sibling port three rounds.
+
+The basis faces the EYE, not the aim axis. Those are the same thing today (the
+head owns the aim) and will not be the moment a tracked controller does.
+=================
+*/
+static void R_VRAddAimMarker( const refdef_t *fd )
+{
+	// 0.0105 radians of half-arm at the default 1.5x setting is about 0.9
+	// degrees, so the whole plus subtends about 2.4 degrees: deliberately
+	// larger than the flat crosshair it replaces, which measured about 0.6
+	// degrees on the device and was reported as too small to find.
+	const float kArmRad = 0.0105f;
+	const float kThickFrac = 0.173f;	// arm half-thickness, as a share of the arm
+	const float kGapFrac = 0.32f;		// centre gap, so the target stays visible
+	static const float ax[4] = {  1.0f, 0.0f, -1.0f,  0.0f };
+	static const float ay[4] = {  0.0f, 1.0f,  0.0f, -1.0f };
+	static const byte  hitColor[4] = { 255, 235, 190, 255 };
+	static const byte  skyColor[4] = { 150, 150, 150, 190 };
+	polyVert_t verts[16];
+	vec3_t eye, eyeAxis[3], ctr, look, cr, cu, along, across, p, wup;
+	float dist, arm, gap, half, range, len;
+	int eyeIdx, seg, i, n;
+
+	if ( !vk_vr_active || ( fd->rdflags & RDF_NOWORLDMODEL ) )
+		return;
+	if ( !cl_vr_xhair_valid || tr.vrXhairShader == NULL || vk_vr_xhair_scale <= 0.0f )
+		return;
+
+	eyeIdx = ( tr.refdef.stereoFrame == STEREO_RIGHT ) ? 1 : 0;
+	R_VRComposeEye( fd->vieworg, fd->viewaxis, eyeIdx, eye, eyeAxis );
+
+	// The marker sits on THIS frame's aim ray, at the range the client's trace
+	// measured. Origin and direction both come from the refdef the cgame just
+	// handed over, so they are current and — crucially — the SAME for both eyes:
+	// a point computed per eye would sit at the same place on both screens,
+	// which is zero disparity, which is a crosshair at infinity however close
+	// the wall is.
+	//
+	// Pulled back along the ray rather than pushed along a surface normal: it
+	// biases in the one direction that is always away from whatever was hit, it
+	// needs nothing from the trace but the range, and a share of the range is
+	// the same bias in DEPTH terms at every distance where a fixed one is not.
+	range = cl_vr_xhair_range - ( ( cl_vr_xhair_range * 0.006f < 1.0f ) ? 1.0f : cl_vr_xhair_range * 0.006f );
+	if ( range < 1.0f )
+		range = 1.0f;
+	VectorMA( fd->vieworg, range, fd->viewaxis[0], ctr );
+
+	VectorSubtract( ctr, eye, look );
+	dist = VectorLength( look );
+	if ( dist < 4.0f )
+		return;		// inside the eye: there is nothing useful to draw
+	VectorScale( look, 1.0f / dist, look );
+
+	arm = kArmRad * vk_vr_xhair_scale * dist * ( cl_vr_xhair_hit ? 1.0f : 0.85f );
+	gap = arm * kGapFrac;
+	half = arm * kThickFrac;
+	if ( half < 0.05f )
+		half = 0.05f;
+
+	// Camera-facing basis, with the engine's own view axes as the fallback for
+	// the one case cross() cannot answer: looking straight up or straight down,
+	// which in this game is a rocket jump and every ledge on every map.
+	VectorSet( wup, 0.0f, 0.0f, 1.0f );
+	CrossProduct( look, wup, cr );
+	len = VectorLength( cr );
+	if ( len < 0.05f ) {
+		VectorCopy( eyeAxis[1], cr );
+		VectorCopy( eyeAxis[2], cu );
+	} else {
+		VectorScale( cr, 1.0f / len, cr );
+		CrossProduct( cr, look, cu );
+		VectorNormalize( cu );
+	}
+
+	n = 0;
+	for ( seg = 0; seg < 4; seg++ ) {
+		for ( i = 0; i < 3; i++ ) {
+			along[i]  =  ax[seg] * cr[i] + ay[seg] * cu[i];
+			across[i] = -ay[seg] * cr[i] + ax[seg] * cu[i];
+		}
+		// One arm = four corners in ring order; RE_AddPolyToScene fans them.
+		// The corners walk the rectangle [gap, gap+arm] x [-half, +half] in the
+		// arm's own basis, so all four arms share one winding by construction.
+		for ( i = 0; i < 4; i++ ) {
+			const float alongLen  = ( i == 1 || i == 2 ) ? ( gap + arm ) : gap;
+			const float acrossLen = ( i == 0 || i == 1 ) ? -half : half;
+			int k;
+			VectorMA( ctr, alongLen, along, p );
+			VectorMA( p, acrossLen, across, p );
+			VectorCopy( p, verts[n].xyz );
+			verts[n].st[0] = 0.5f;
+			verts[n].st[1] = 0.5f;
+			for ( k = 0; k < 4; k++ )
+				verts[n].modulate.rgba[k] = cl_vr_xhair_hit ? hitColor[k] : skyColor[k];
+			n++;
+		}
+	}
+
+	RE_AddPolyToScene( tr.vrXhairShader->index, 4, verts, 4 );
+}
+#endif
