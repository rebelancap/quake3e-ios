+#ifdef USE_VULKAN_API
 /*
+=================
+CL_VRAimMarker
+
+How far along the aim ray the shot would land, in world units, so the renderer
+can put a marker there.
+
+A crosshair painted on a flat overlay sits at the near plane in both eyes and
+fuses at no distance at all: the eyes are asked to converge on something metres
+away that is drawn as though it were at arm's length, which reads as a double
+image. A marker at the distance the ray actually reaches converges naturally and
+lands on the surface being aimed at.
+
+Only the DISTANCE and the hit flag cross over. The renderer already has the aim
+ray — the origin and forward axis the cgame handed it this frame, identical for
+both eyes — so placing the marker from those keeps it eye-independent (which is
+what makes the stereo depth right) and free of the frame of lag that reusing a
+snapshot origin over there would add.
+
+The ray is the EFFECTIVE aim, not the sent angles: pmove computes the view as
+the usercmd's angles PLUS the playerstate's delta_angles, so reconstructing the
+sum here is what makes the marker agree with the bullet by construction rather
+than by two pieces of arithmetic staying in step. Same reason the pitch write
+above subtracts that offset.
+
+The trace is client-side and world-only, against the collision model the client
+already has loaded: no players, no items, no server round trip. Aiming at a body
+therefore measures the wall behind it, which is the honest answer for a marker
+whose job is depth — and it costs nothing per frame.
+
+DEFINED here rather than in the renderer for the same reason cl_vr_height_rise
+is: the client links in every configuration, the renderer does not.
+=================
+*/
+int   cl_vr_xhair_valid = 0;
+int   cl_vr_xhair_hit = 0;
+float cl_vr_xhair_range = 0.0f;
+
+// Far enough to leave the map in every stock arena, so "hit nothing" means the
+// sky and not a limit this code invented.
+#define CL_VR_AIM_RANGE 8192.0f
+
+static void CL_VRAimMarker( void )
+{
+	vec3_t angles, forward, right, up, start, end;
+	trace_t tr;
+
+	cl_vr_xhair_valid = 0;
+
+	if ( !cl_vr_head_aim_active || cls.state != CA_ACTIVE || !cl.snap.valid )
+		return;
+	if ( clc.demoplaying || cl.snap.ps.pm_type == PM_INTERMISSION ||
+		 cl.snap.ps.pm_type == PM_SPINTERMISSION )
+		return;
+	// The collision model belongs to the cgame's map load, so it is only safe
+	// to trace against once the cgame has started. CM_NumInlineModels is the
+	// cheapest question that answers "is a map loaded" without adding an
+	// interface: 0 with no map, at least 1 (the world) with one.
+	if ( !cls.cgameStarted || CM_NumInlineModels() < 1 )
+		return;
+
+	// The effective view angles, in the same 16-bit circular domain pmove adds
+	// them together in.
+	angles[PITCH] = SHORT2ANGLE( (short)( ANGLE2SHORT( cl.viewangles[PITCH] ) + cl.snap.ps.delta_angles[PITCH] ) );
+	angles[YAW]   = SHORT2ANGLE( (short)( ANGLE2SHORT( cl.viewangles[YAW] )   + cl.snap.ps.delta_angles[YAW] ) );
+	angles[ROLL]  = 0.0f;
+	AngleVectors( angles, forward, right, up );
+
+	VectorCopy( cl.snap.ps.origin, start );
+	start[2] += (float)cl.snap.ps.viewheight;
+	VectorMA( start, CL_VR_AIM_RANGE, forward, end );
+
+	CM_BoxTrace( &tr, start, end, vec3_origin, vec3_origin, 0, CONTENTS_SOLID, qfalse );
+
+	// startsolid: the eye is inside a brush (a lift ceiling closing, a telefrag
+	// frame). A marker at the eye is worse than none, so there is none.
+	if ( tr.startsolid || tr.allsolid )
+		return;
+
+	// Nothing hit — the sky is not solid to this trace, so the range stays at
+	// the full reach, where the eyes converge at effectively infinity. That is
+	// comfortable; a made-up near distance is not.
+	cl_vr_xhair_hit = ( tr.fraction < 1.0f ) ? 1 : 0;
+	cl_vr_xhair_range = tr.fraction * CL_VR_AIM_RANGE;
+	cl_vr_xhair_valid = 1;
+}
+#endif // USE_VULKAN_API
+
