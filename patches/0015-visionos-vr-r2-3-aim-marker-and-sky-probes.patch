+// The union is per FIELD, not per batch: a sky shader that overflows tess
+// re-enters this pass several times per eye, each time with a partial set of
+// polygons, and reporting only the last of those would read as a narrow sky on
+// a frame that drew a whole one.
+typedef struct {
+	int		batches;
+	int		tris;
+	int		drawn[6];
+	float	mins[6][2];
+	float	maxs[6][2];
